{
  "name": "@band-ai/claude-code-plugin",
  "version": "0.1.0",
  "description": "Claude Code plugin that connects an interactive Claude Code session to the Band AI agent collaboration platform",
  "author": "Band <hello@band.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/band-ai/band-sdk-typescript.git",
    "directory": "packages/claude-code"
  },
  "type": "module",
  "main": "dist/server.js",
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "skills"
  ],
  "scripts": {
    "build": "tsup && node scripts/sync-plugin-version.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm run build && vitest run --coverage",
    "clean": "rm -rf dist skills"
  },
  "devDependencies": {
    "@band-ai/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
