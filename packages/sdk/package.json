{
  "name": "@band-ai/sdk",
  "version": "0.3.4",
  "description": "Band TypeScript SDK core runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/band-ai/band-sdk-typescript.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/adapters.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./converters": {
      "types": "./dist/converters.d.ts",
      "import": "./dist/converters.js",
      "require": "./dist/converters.cjs"
    },
    "./linear": {
      "types": "./dist/linear.d.ts",
      "import": "./dist/linear.js",
      "require": "./dist/linear.cjs"
    },
    "./rest": {
      "types": "./dist/rest.d.ts",
      "import": "./dist/rest.js",
      "require": "./dist/rest.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js",
      "require": "./dist/mcp.cjs"
    },
    "./mcp/claude": {
      "types": "./dist/mcp-claude.d.ts",
      "import": "./dist/mcp-claude.js",
      "require": "./dist/mcp-claude.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "dev:linear": "tsx --env-file-if-exists=.env.local examples/linear-band/linear-band-bridge-server.ts",
    "start:linear": "tsx examples/linear-band/linear-band-bridge-server.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@band-ai/band-sdk-core": "2.4.0",
    "@band-ai/rest-client": "0.0.143",
    "js-yaml": "^5.4.2",
    "phoenix": "^1.8.14",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@a2a-js/sdk": ">=0.3.10",
    "@agentclientprotocol/sdk": ">=1.4.0",
    "@anthropic-ai/claude-agent-sdk": ">=0.2.63",
    "@anthropic-ai/sdk": ">=0.78.0",
    "@google/adk": ">=0.5.0",
    "@google/genai": ">=1.44.0",
    "@langchain/core": ">=1.1.31",
    "@langchain/langgraph": ">=1.2.0",
    "@letta-ai/letta-client": ">=1.7.0",
    "@linear/sdk": ">=76.0.0",
    "@modelcontextprotocol/sdk": ">=1.10.0",
    "@openai/codex-sdk": ">=0.107.0",
    "@opencode-ai/sdk": ">=1.3.0",
    "ai": ">=6.0.137",
    "express": ">=5.2.1",
    "openai": ">=6.27.0",
    "parlant-client": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@a2a-js/sdk": {
      "optional": true
    },
    "@agentclientprotocol/sdk": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@google/adk": {
      "optional": true
    },
    "@google/genai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@letta-ai/letta-client": {
      "optional": true
    },
    "@linear/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "@opencode-ai/sdk": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "parlant-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "@linear/sdk": "^95.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.154.0",
    "@opencode-ai/sdk": "^1.18.30",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "ai": "^7.0.99",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  }
}
