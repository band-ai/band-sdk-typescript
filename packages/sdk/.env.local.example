BAND_API_KEY=bnd_a_xxx
BAND_REST_URL=https://app.band.ai

LINEAR_ACCESS_TOKEN=lin_api_xxx
LINEAR_WEBHOOK_SECRET=lin_wh_xxx

LINEAR_BAND_STATE_DB=.linear-thenvoi-example.sqlite
LINEAR_BAND_ROOM_STRATEGY=issue
LINEAR_BAND_WRITEBACK_MODE=activity_stream
# Legacy LINEAR_THENVOI_* names are accepted as per-field fallback.

BAND_HOST_AGENT_HANDLE=your-org/linear-orchestrator
CODEX_MODEL=gpt-5.3-codex
PORT=8787

# Optional if the embedded Band Linear PM agent should load a specific config entry.
# If omitted, the agent uses the default linear_band_bridge config key.
# Legacy key linear_thenvoi_bridge is accepted with a deprecation warning.
LINEAR_BAND_BRIDGE_RUNTIME_CONFIG_KEY=linear_band_bridge
